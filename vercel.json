{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/Pixelspinx-Com",
      "destination": "/pixelspinx-com",
      "permanent": true
    },
    {
      "source": "/Pixelspinx-Com.html",
      "destination": "/pixelspinx-com",
      "permanent": true
    },
    {
      "source": "/redeepseek",
      "destination": "/redeepseek-com",
      "permanent": true
    },
    {
      "source": "/apkek",
      "destination": "/apkek-org",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
